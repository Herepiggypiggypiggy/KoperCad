# Auto detect text files and perform LF normalization
* text=auto

# Files that tests compare byte for byte with what the code generates (lesson
# projects, lesson text, the anchors doc) stay LF in a Windows checkout.
assets/lessons/** text eol=lf
docs/design/*.md text eol=lf
crates/novo-storage/tests/fixtures/*.json text eol=lf

# Source files that tests read with include_str!/read_to_string and match on "\n"
# (tips_tests, languages_tests) stay LF in a Windows checkout.
*.rs text eol=lf
