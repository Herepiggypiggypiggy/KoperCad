FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    location "system";
    object controlDict;
}

application buoyantBoussinesqSimpleFoam;
startFrom startTime;
startTime 0;
stopAt endTime;
endTime 4000;
deltaT 1;
writeControl timeStep;
writeInterval 4000;
purgeWrite 2;
writeFormat ascii;
writeCompression off;
timeFormat general;
timePrecision 6;
runTimeModifiable true;

functions
{
    meanT { type volFieldValue; libs (fieldFunctionObjects); operation volAverage; regionType all; fields (T); writeFields no; writeControl timeStep; writeInterval 50; }
    maxT { type volFieldValue; libs (fieldFunctionObjects); operation max; regionType all; fields (T); writeFields no; writeControl timeStep; writeInterval 50; }
