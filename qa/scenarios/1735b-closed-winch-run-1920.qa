@title Closed-loop winch run: torque is proven, the drawn brake contactor opens the brake and the hook rises
@area Simulate
@sizes 1920x1080
# Opens the closed-loop winch fixture, starts Simulate > Drive run, switches Live on.
open qa/fixtures/closed-winch.novo
wait 20
key ctrl+k
wait 3
text Simulate drive run
wait 4
key Enter
wait 20
click_text "Switch on Live"
wait 20
click_text "Start"
wait 20
key Home
wait 30
shot before-pressing
# Radio step 2 (S2): the drive proves its torque, the relay contact in the drawing closes the brake
# contactor, the brake opens, the hook rises.
mouse_down 370 352
wait 400
shot torque-proof-and-brake-opens
wait 700
expect "running"
expect_not "brake closed · 0 rpm"
shot running
mouse_up 370 352
wait 800
expect "brake closed"
check_layout
shot stopped-brake-closed
