@title Lesson walk: simulate-3d (3D view, Heat panel, Quick run, verdict, labels)
@area Learn
@sizes 1366x768
# 1366x768 only: the Heat panel keeps clear of the lesson card there and is short, so the settings are reached by scrolling it; the 1920x1080 walk passed without. The lesson from the palette, in the hot cabinet sample. Do it for me only carries out commands, so the Heat button, the Quick choice and the Simulate button are really clicked. The Quick run takes seconds to a minute on a worker thread.
key ctrl+k
wait 4
text simulate
wait 6
click_text "Heat and air in 3D: the Simulate run"
wait 40
shot 01-why
check_layout
try click_text "Next"
wait 20
shot 02-open-3d
check_layout
try click_text "Do it for me"
wait 40
shot 03-heat-panel-step
check_layout
click_text Heat #1
wait 20
shot 04-settings-step
check_layout
scroll 1180 300 -300
wait 10
shot 04b-heat-panel-scrolled
click_text "Settings for the next run"
wait 10
click_text Quick
wait 10
shot 05-quick-chosen
check_layout
try click_text "Next"
wait 20
shot 06-simulate-step
check_layout
click_text Simulate #2
wait_s 100
wait 60
wait_s 100
wait 60
wait_s 100
wait 60
expect "Result for this layout"
shot 07-verdict-step-result
check_layout
try click_text "Next"
wait 20
shot 08-labels-step
check_layout
try click_text "Next"
wait 20
shot 09-stale-step
check_layout
try click_text "Next"
wait 20
shot 10-estimate-step
check_layout
