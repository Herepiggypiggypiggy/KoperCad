@title Ctrl+K: "learning paths" finds Learn and "continue lesson" finds the lesson command
@area Learn
# Creative round 26: both words found nothing (S2). The palette matches each phrase against the command's keywords.
click_text "Open example"
wait 20
key ctrl+k
wait 4
text learning paths
wait 6
shot learning-paths
expect "Learn"
key escape
wait 6
key ctrl+k
wait 4
text continue lesson
wait 6
shot continue-lesson
expect "lesson"
