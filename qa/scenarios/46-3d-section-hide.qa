@title 3D view: section plane and hide / show all
@area 3D
# Cut the picture with a plane, turn the axis, then hide the selection of all devices and show everything again.
click_text "Open example"
wait 20
click_text 3D #1
wait 40
click_text Section
wait 10
click_text "Cut the picture with a plane"
wait 20
click_text X
wait 20
shot section-x
key Escape
wait 6
click_text "Select and hide"
wait 10
click_text "Select all devices"
wait 10
click_text "Select and hide"
wait 10
click_text "Hide selection"
wait 20
shot devices-hidden
click_text "Select and hide"
wait 10
click_text "Show all"
wait 20
shot shown-again
check_layout
