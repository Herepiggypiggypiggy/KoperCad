@title Example gallery: overhead crane cabinet
@area Examples
# File > Examples > Open example: overhead crane cabinet. Every page, the cabinet and 3D.
fresh
wait 10
key ctrl+k
wait 6
text overhead crane
wait 8
key Enter
wait 40
expect "Supply, main contactor and 48 V"
shot crane-page-1
check_blank crane-page-1
check_layout
click 140 242
wait 12
shot crane-page-2
click 140 271
wait 12
shot crane-page-3
click 140 300
wait 12
shot crane-page-4
click 140 329
wait 12
shot crane-page-5
click 140 358
wait 12
shot crane-page-6
click_text "Cabinet"
wait 20
shot crane-cabinet
check_blank crane-cabinet
click_text "3D"
wait 30
shot crane-3d
