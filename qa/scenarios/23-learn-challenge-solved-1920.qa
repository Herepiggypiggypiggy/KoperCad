@title Challenge lesson repaired by hand ends on Solved (1920x1080)
@area Learn
@sizes 1920x1080
# Pin positions are for 1920x1080 (the page panel is open there); the 1366x768 run is scenario 22.
# The lesson page opens on the whole sheet (a fit shows the sheet unless the drawing is twice as large close up, #1208), so the points are the pins at that zoom.
key ctrl+k
wait 4
text hold in
wait 6
click_text "The motor will not hold in"
wait 40
key shift+l
wait 40
click_text Connect
wait 6
click 733 388
wait 4
move 708 388
wait 4
click 683 388
wait 10
shot repaired
click_text "Hold to press" #2
wait 20
shot after-start
click_text "Hold to press" #1
wait 40
shot end-solved
expect "Solved"
expect_not "Shown, not solved"
check_layout
