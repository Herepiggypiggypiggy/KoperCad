@title Circuit library: the maintenance socket circuit is found and placed
@area Schematic
# Batch 5 of the circuit library: a new circuit is found by search and placed on the page.
click_text "New project"
wait 20
key ctrl+k
text "place macro"
wait 5
key Enter
wait 10
click 237 94
text "maintenance socket"
wait 5
expect "Circuits/1 Supply"
click_text "Maintenance socket with RCBO" Label
wait 10
expect "Mounting view"
shot socket-picked
click_text Place Button
wait 30
expect_scene "-F1"
shot socket-placed
