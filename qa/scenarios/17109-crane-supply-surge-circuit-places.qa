@title Circuit library: the crane supply surge circuit is found and placed
@area Schematic
@sizes 1366x768
# Batch 5 of the circuit library: a new circuit is found by search and placed on the page.
click_text "New project"
wait 20
key ctrl+k
text "place macro"
wait 5
key Enter
wait 10
# The macro window docks on the right; its search box is at x 1205 in a 1366 wide window.
click 1205 103
wait 3
text "surge protection"
wait 5
expect "Circuits/1 Supply"
click_text "Crane supply with surge protection" Label
wait 10
expect "Mounting view"
shot surgesupply-picked
click_text Place Button
wait 30
expect_scene "-S1"
shot surgesupply-placed
