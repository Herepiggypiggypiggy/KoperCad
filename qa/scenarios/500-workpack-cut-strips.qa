@title Work cards: cut-and-label strips for the wires, longest first with ferrule and marker
@area 3D
# The example project has wires: its pack now ends with cut strip cards (longest first, ferrule, marker flag). keep_file keeps the PDF for the pictures.
click_text "Open example"
wait 20
click_text 3D #1
wait 40
click_text "Layers"
wait 8
click_text "Build order"
wait 8
key Escape
wait 30
click_text "Next"
wait 12
click_text "Next"
wait 12
shot strip-with-work-cards-button
expect "Work cards (PDF)"
check_layout
answer_dialog "~/Documents/KoperCAD/qa 500 work cards.pdf"
click_text "Work cards (PDF)"
wait 40
shot after-print
expect_file "~/Documents/KoperCAD/qa 500 work cards.pdf" 3000
keep_file "~/Documents/KoperCAD/qa 500 work cards.pdf"
