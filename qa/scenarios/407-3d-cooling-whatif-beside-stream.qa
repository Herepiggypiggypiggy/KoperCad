@title Cooling what-if: a fan fix names the devices beside its stream
@area 3D
@sizes 1366x768 1920x1080
# The first fix of the hot cabinet adds an exhaust fan; devices that stand beside the line between the fan and the vent are named under the fan note, and the Apply button stays in reach.
open qa/fixtures/cabinet-cooling-advice.novo
wait 20
click_text 3D #1
wait 30
click_text Heat #1
wait 20
# Opening Heat starts an automatic run: stop it, switch Auto off so it does not restart, and stop again.
click_text Cancel
wait 10
click_text Auto #1
wait 10
wait 30
try click_text Cancel
wait 30
try click_text Cancel
wait 20
click_text "Cooling what-if"
wait 20
click_text "Try the fixes"
wait_s 120
expect "Devices over limit"
scroll 250 560 -400
wait 10
expect "Beside the assumed fan stream"
shot beside-stream
check_layout
