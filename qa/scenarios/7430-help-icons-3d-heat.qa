@title Help icons: the 3D Heat strip, Heat panel and Vents window carry no explanation text
@area 3D
@sizes 1366x768 1920x1080
# The explanations of the Heat strip, the Heat panel and the Vents and fans window sit behind one ? icon per window; check_text fails on any label of more than 40 words (result sentences and page names still run to 20 to 36 words; the target is 8).
open qa/fixtures/cabinet-cooling-advice.novo
wait 20
click_text 3D #1
wait 30
click_text Heat #1
wait 20
click_text Cancel
wait 10
click_text Auto #1
wait 10
wait 30
try click_text Cancel
wait 30
try click_text Cancel
wait 60
try click_text Cancel
wait 20
click_text "Settings for the next run"
wait 10
try click_text Quick
wait 10
click_text Simulate #2
wait_s 200
shot heat-clean
check_text 40
check_layout
expect "Model estimate"
expect_not "What is this?"
expect_not "Model estimate, not a measurement."
# Each popup closes on a click outside it: a click on the empty canvas.
click_text Help #1
wait 8
shot help-a
click 700 690
wait 6
click_text Help #2
wait 8
shot help-b
click 700 690
wait 6
try click_text Help #3
wait 8
try shot help-c
click 700 690
wait 6
