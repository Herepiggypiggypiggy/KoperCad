@title Help icons: Hoist run and Hoist in 3D carry no explanation text, the ? popup says it
@area Simulate
@sizes 1366x768 1920x1080
# Hoist run keeps one short qualifier line, its notes are behind the ? of its header (popup open in the second picture).
open qa/fixtures/hoist-two-speed.novo
wait 20
key ctrl+k
wait 3
text Simulate hoist run
wait 4
key Enter
wait 30
shot hoist-run
expect "Model, not measurement. Not a safety function."
check_text 40
check_layout
click_text Help
wait 8
shot hoist-run-help-open
key Escape
wait 4
key Escape
wait 6
key ctrl+k
wait 3
text Hoist in 3D
wait 4
key Enter
wait 30
shot hoist-3d
expect "Picture, not measurement"
check_text 40
check_layout
click_text Help
wait 8
shot hoist-3d-help-open
