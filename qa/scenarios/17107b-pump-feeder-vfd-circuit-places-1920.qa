@title Circuit library: the pump VFD feeder circuit is found and placed
@area Schematic
@sizes 1920x1080
# Batch 4 of the circuit library: a new circuit is found by search and placed on the page.
click_text "New project"
wait 20
key ctrl+k
text "place macro"
wait 5
key Enter
wait 10
# The macro window docks on the right; its search box is at x 1759 in a 1920 wide window.
click 1759 103
wait 3
text "pump feeder"
wait 5
expect "Circuits/2 Protection"
click_text "Pump feeder frequency controlled" Label
wait 10
expect "Mounting view"
shot pumpfeeder-picked
click_text Place Button
wait 30
expect_scene "-Q1"
shot pumpfeeder-placed
