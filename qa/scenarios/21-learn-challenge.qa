@title Challenge lesson: ring waits for hints, end card says solved or shown
@area Learn
# Round 8 findings 8.1 to 8.4 (audit/creative/round8.md).
key ctrl+k
wait 4
text hold in
wait 6
click_text "The motor will not hold in"
wait 40
shot live-step
expect "The motor will not hold in"
check_layout
# Live view on: the goal step opens with no ring on the faulty pin and the hints closed.
key shift+l
wait 40
shot goal-no-ring
expect "Hint (1 / 3)"
check_layout
click_text "Hint (1 / 3)"
wait 6
click_text "Hint (2 / 3)"
wait 6
click_text "Hint (3 / 3)"
wait 10
shot goal-hints-open
# Do it for me ends on "Shown, not solved" with the explanation.
click_text "Do it for me"
wait 60
shot end-shown
expect "Shown, not solved"
expect "holding contact"
check_layout
