@title A failed import is a red triangle in the top bar with Retry-less actions, not a fading toast (1920x1080)
@area Files
@sizes 1920x1080
# T12: a file that is not a DXF makes the import fail. The failure becomes a red triangle (the job flag) next to the Issues pill; its popover has the plain words, Copy details and Dismiss. No toast text is left on the screen.
click_text "New project"
wait 20
answer_dialog qa/fixtures/files/not-a-drawing.dxf
key ctrl+k
text import dxf as background
wait 5
key Enter
wait 20
shot job-flag-triangle
check_layout
expect "DXF import failed"
click_text "DXF import failed" Button
wait 8
expect "Copy details"
expect "Dismiss"
shot job-flag-popover
check_layout
click_text "Dismiss" Button
wait 8
expect_not "Copy details"
expect_not "DXF import failed"
shot job-flag-gone
