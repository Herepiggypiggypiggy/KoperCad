@title MCC template motor places at 1920: six feeders, the cover structure sheet lists Motor 1 to 6
@sizes 1920x1080
@area Schematic
wait 20
key ctrl+k
wait 6
text new from template motor control centre
wait 8
key Return
wait 12
click_text "6"
click_text "Create project"
wait 30
shot template-opened
expect "Control supply"
click 150 123
wait 10
shot pages-panel
click 150 123
text Front
wait 10
shot pages-filtered
click 150 233
wait 20
shot cover-structure-motors
check_layout
