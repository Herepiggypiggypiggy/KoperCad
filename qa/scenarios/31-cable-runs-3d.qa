@title Cable runs in 3D: Wire runs list, Run card, lit path
@area 3D
# The EMC example has a motor cable (=A1+CAB-W2). 3D > Wire runs (Ctrl+K): pick a core of the cable, select all its cores, then pick one wire and read the Run card.
key ctrl+k
wait 6
text open emc example
wait 8
key Enter
wait 30
click_text 3D #1
wait 40
key ctrl+k
wait 3
text wire runs
wait 4
key Enter
wait 40
shot wire-runs-list
expect "Wire runs"
click_text "=A1+CAB-U1:U"
wait 40
scroll 1200 560 -900
wait 5
shot run-card-core
expect "Select all cores of the cable"
expect "Not checked: how stiff this cable is"
click_text "Select all cores of the cable"
wait 60
shot cable-cores
expect "runs"
expect "Cable =A1+CAB-W2"
click_text "4   682 mm"
wait 60
scroll 1200 560 -900
wait 5
shot run-card-routed
expect "Run 4"
expect "routed"
expect "Duct at"
