@title Tool rail: tools, Connect flyout, expand, panels zone (Schematic)
@area Layout
@sizes 1366x768
# Lane V3a of the visual redesign (docs/design/visual-redesign.md section 3.2).
# The rail replaces the floating tool dock. Left edge of the Schematic workspace.
click_text "New project"
wait 20
shot rail-collapsed
check_layout
click 23 138
wait 8
shot connect-started
click 23 138
wait 8
shot connect-flyout
expect "Wire shape"
expect "Auto-connect pins that touch"
check_layout
key Escape
wait 6
expect_not "Wire shape"
key Escape
wait 4
click 23 722
wait 8
shot rail-expanded
expect "Place symbol"
expect "Autopilot"
expect "Terminals"
check_layout
click 23 722
wait 6
