@title Work cards: Export centre and command field
@area Reports
# File > Export... lists "Export work cards (PDF)" among the workshop formats, also the command field ("export work cards"). Same file as the Build order strip button.
click_text "Open example"
wait 20
click_text File #1
wait 8
click_text "Export..."
wait 8
shot export-centre
expect "Export work cards (PDF)"
key Escape
wait 6
key ctrl+k
wait 4
text Export work cards
wait 6
shot palette
answer_dialog "~/Documents/KoperCAD/qa 184 work cards.pdf"
key Enter
wait 40
expect_file "~/Documents/KoperCAD/qa 184 work cards.pdf" 3000
keep_file "~/Documents/KoperCAD/qa 184 work cards.pdf"
check_layout
