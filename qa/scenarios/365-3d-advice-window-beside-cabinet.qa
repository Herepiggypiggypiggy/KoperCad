@title 3D Cooling advice window sits beside the cabinet and a fan option shows its fan icon
@area 3D
@sizes 1366x768 1920x1080
# The advice window opens at the right edge so the cabinet stays visible; adding the pair leaves the new fan in view.
open qa/fixtures/cabinet-cooling-advice.novo
wait 20
click_text 3D #1
wait 30
click_text Heat #1
wait 20
click_text "Settings for the next run"
wait 10
click_text Quick
wait 10
click_text Simulate #2
wait_s 45
click_text "Cooling advice"
wait_s 90
expect "Tightest margin"
shot advice-open
check_layout
click_text "Add these two" Button
wait 20
shot after-add
