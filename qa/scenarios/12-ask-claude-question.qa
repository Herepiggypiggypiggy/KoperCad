@title Ask Claude asks a question instead of guessing, and the answer buttons work
@area Assistant
@env KOPERCAD_AI_REPLAY=qa/replay/ask-question.json
@env ANTHROPIC_API_KEY=sk-ant-api03-qa-replay-key-0000000000
# Answers come from qa/replay/ask-question.json, nothing is sent.
click_text "New project"
wait 20
key ctrl+k
wait 6
text ask claude
wait 8
key Enter
wait 10
expect "Test replay"
scroll 250 300 -300
wait 4
click_text "Whole project"
wait 4
scroll 250 300 -3000
wait 4
shot first-run-consent
click_text "I have read this and agree"
wait 4
click_text "Turn Claude on" Button
wait 8
expect "Claude is on"
check_layout
click_text "" MultilineTextInput
wait 3
text Add a motor starter.
click_text Send Button
wait 40
expect "Claude asks"
expect "Or type your answer below."
shot ask-claude-question
check_layout
