@title A wire in progress is cancelled by Esc or right click, and the hint says so (1920x1080)
@area Schematic
@sizes 1920x1080
# Test report 13: Backspace was the only cancel and it was shown only in the status line. Esc and right click cancel now and the hint says it.
click_text "New project"
wait 20
key ctrl+k
text "motor starter dol"
wait 5
key Enter
wait 10
try click_text "Motor starter DOL" Label
wait 10
click_text Place Button #2
wait 20
click_text Corners
wait 3
click 560 190
wait 5
shot wire-started
expect "Esc or right-click cancels"
click 1000 800 right
wait 5
shot wire-cancelled
expect_not "Esc or right-click cancels"
click_text Corners
wait 3
click 560 190
wait 5
shot wire-started-again
expect "Esc or right-click cancels"
key Escape
wait 5
shot esc-cancelled
expect_not "click a pin or wire to finish"
