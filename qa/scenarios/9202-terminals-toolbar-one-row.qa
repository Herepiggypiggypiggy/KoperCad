@title Terminals drawer: the toolbar is one row, so the strip keeps its rows
@area Terminals
@sizes 1366x768
# Regression (TCN-04): wrapped tool buttons took two rows of the drawer at 1366x768. Same set-up as scenario 69.
# Fixture: a motor and a sensor drawn at the cabinet (+CAB), as the starter macros do.
open qa/fixtures/strip-grouping.novo
wait 30
key ctrl+k
wait 3
text devices
wait 4
key Enter
wait 20
click 300 200
key Home
wait 20
shot a-before
click 218 430
click 433 412 shift
wait 10
shot b-two-selected
expect "Set location of 2 selected"

click 325 568
text +FIELD
key Enter
wait 20
expect "+FIELD"
shot c-after-set-location
check_layout
# The field devices now sit across a location boundary: seven terminals are proposed. By default they
# go on strips by kind, not all on one.
click 93 530
wait 10
expect "Accept 7 proposed"
shot d-terminals-proposed
check_layout
click_text "Accept 7 proposed"
wait 20
expect_scene "=A1+CAB-X1"
expect_scene "=A1+CAB-X2"
expect_scene "=A1+CAB-X3"
expect_scene "=A1+CAB-X4"
expect "Add spare terminals"
shot toolbar-one-row
check_layout
