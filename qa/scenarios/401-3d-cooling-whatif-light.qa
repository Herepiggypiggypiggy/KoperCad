@title Cooling what-if in the Light look
@area 3D
@sizes 1366x768
# Same route as 400 in the Light look: the badge, the table and the fix cards stay readable on a light window.
open qa/fixtures/cabinet-cooling-advice.novo
wait 20
key ctrl+k
wait 6
text preferences
wait 8
key Enter
wait 10
click_text Light
wait 10
key Escape
wait 6
click_text 3D #1
wait 30
click_text Heat #1
wait 20
click_text "Cooling what-if"
wait 20
shot conditions-light
check_layout
click_text "Try the fixes"
wait_s 120
expect "MODEL, NOT MEASURED"
expect "Devices over limit"
shot ranked-light
check_blank ranked-light
check_layout
