@title Circuit library: the hoist encoder circuit is found and placed
@area Schematic
@sizes 1920x1080
# Batch 4 of the circuit library: a new circuit is found by search and placed on the page.
click_text "New project"
wait 20
key ctrl+k
text "place macro"
wait 5
key Enter
wait 10
# The macro window docks on the right; its search box is at x 1759 in a 1920 wide window.
click 1759 103
wait 3
text encoder
wait 5
expect "Circuits/3 Hoists"
click_text "Hoist drive with encoder speed feedback" Label
wait 10
expect "Mounting view"
shot encoder-picked
click_text Place Button
wait 30
expect_scene "-B1"
shot encoder-placed
