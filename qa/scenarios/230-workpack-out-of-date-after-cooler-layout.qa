@title Work cards: printed, then a cooler layout is applied, the strip says the cards are out of date
@area 3D
@sizes 1366x768
# Print the cards, apply a cooling move, and the Build order strip names how many cards changed. The next print marks them CHANGED.
open qa/fixtures/cabinet-cooler-layout.novo
wait 30
click_text 3D #1
wait 40
click_text "Layers"
wait 8
click_text "Build order"
wait 8
key Escape
wait 30
shot before-print
answer_dialog "~/Documents/KoperCAD/qa 230 work cards.pdf"
click_text "Work cards (PDF)"
wait 40
expect_file "~/Documents/KoperCAD/qa 230 work cards.pdf" 3000
shot printed
click_text Heat #1
wait 20
# Heat starts a Thorough run by itself on this small cabinet and greys the Quality row: stop it, switch Auto off, run Quick, then open the cooling buttons.
click_text Cancel
wait 10
click_text Auto #1
wait 10
wait 30
try click_text Cancel
wait 30
try click_text Cancel
wait 20
click_text "Settings for the next run"
wait 10
click_text Quick
wait 10
click_text Simulate #2
wait_s 120
click_text "Cooling selection"
wait 10
scroll 1190 560 -500
wait 10
click_text "Cooler layout"
wait_s 120
expect "Apply the moves"
click_text "Apply the moves"
wait 30
shot applied
click_text 3D #1
wait 30
shot stale
expect "Work cards out of date"
check_layout
click_text Reports
wait 5
click_text "Bench output..."
wait 20
shot bench-stale
expect "Work cards out of date"
check_layout
key Escape
wait 10
answer_dialog "~/Documents/KoperCAD/qa 230 work cards again.pdf"
click_text "Work cards (PDF)"
wait 40
expect_file "~/Documents/KoperCAD/qa 230 work cards again.pdf" 3000
keep_file "~/Documents/KoperCAD/qa 230 work cards again.pdf"
keep_file "~/Documents/KoperCAD/qa 230 work cards.pdf"
shot reprinted
