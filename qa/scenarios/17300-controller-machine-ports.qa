@title Controller machine ports: the radio drives the hoist through bound ports
@area Live
@sizes 1366x768
# Lane L5b. The fixture has a hoist -M1 and a bridge axis -M2 known to the machine model only (no
# drawn circuit) and one generic radio bound to their ports. The Hoist run reads the ports.
open qa/fixtures/radio-machine.novo
wait 20
key ctrl+k
wait 3
text Simulate hoist run
wait 4
key Enter
wait 20
click_text "Switch on Live"
wait 20
click_text "Start"
wait 20
drag 1000 82 480 82
wait 10
click_text "Controller…"
wait 20
expect "Controller: radio-1/HOIST_UP_SLOW"
shot before-main
# Main on, then hold up step 2: the machine port lifts the hook with no drawn circuit.
click 840 315
wait 10
mouse_down 888 482
wait 120
expect "brake open"
shot hook-rising
mouse_up 888 482
wait 120
expect "0 rpm"
# E-stop with the rocker held: the permit port stops the hoist.
mouse_down 888 482
wait 60
click 860 265
wait 60
expect "brake closed"
shot e-stop
mouse_up 888 482
check_layout
