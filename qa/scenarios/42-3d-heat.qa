@title 3D view: Heat panel, Simulate, verdict and pinned hot-spot labels
@area 3D
# Heat button in the 3D toolbar opens the Heat panel; a run shows the verdict, the colours on the devices and pinned labels.
open_starter_example
wait 20
click_text 3D #1
wait 30
click_text Heat #1
wait 20
shot heat-panel
# Heat starts a run by itself (Thorough, Auto on) and greys out the Quality row: stop it, switch Auto off, stop again, then run Quick.
click_text Cancel
wait 10
click_text Auto #1
wait 10
wait 30
try click_text Cancel
wait 30
try click_text Cancel
wait 20
click_text "Settings for the next run"
wait 10
click_text Quick
wait 10
click_text Simulate #2
wait 300
shot heat-working
wait 300
move 700 650
wait 10
shot heat-result
check_blank heat-result
check_layout
