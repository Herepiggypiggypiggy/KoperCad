@title Lesson walk after the rail: cross-references (every step, Do it for me or Next)
@area Learn
# Lane V3a: the tool dock became the tool rail; this walk finds lesson text or anchors that still point at the dock.
key ctrl+k
wait 4
text Cross references
wait 6
click_text "Cross references"
wait 40
shot 01-start
check_layout
try click_text "Do it for me"
wait 25
try click_text "Next"
wait 15
shot 02-step
check_layout
try click_text "Do it for me"
wait 25
try click_text "Next"
wait 15
shot 03-step
check_layout
try click_text "Do it for me"
wait 25
try click_text "Next"
wait 15
shot 04-step
check_layout
try click_text "Do it for me"
wait 25
try click_text "Next"
wait 15
shot 05-step
check_layout
try click_text "Do it for me"
wait 25
try click_text "Next"
wait 15
shot 06-step
check_layout
try click_text "Do it for me"
wait 25
try click_text "Next"
wait 15
shot 07-step
check_layout
