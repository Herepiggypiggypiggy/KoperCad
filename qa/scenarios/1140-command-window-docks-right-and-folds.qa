@title A command window opens docked in the right strip, folds up to its title, unfolds, and Escape closes it (1366x768)
@area Windows
@sizes 1366x768
open_starter_example
wait 30
key ctrl+k
wait 4
text standards check
wait 6
key Enter
wait 40
expect "Check against"
shot docked-open
check_layout
# The fold arrow is the first button in the pane header.
click 1061 72
wait 30
expect_not "Check against"
shot folded
check_layout
click 1061 72
wait 30
expect "Check against"
shot unfolded
# Escape closes the window docked last, like a floating one.
key Escape
wait 20
expect_not "Check against"
shot after-escape
