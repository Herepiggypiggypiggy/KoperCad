@title Ask Claude suggests a wire number and Apply changes it
@area Assistant
@env KOPERCAD_AI_REPLAY=qa/replay/wire-number.json
@env ANTHROPIC_API_KEY=sk-ant-api03-qa-replay-key-0000000000
# Answers come from qa/replay/wire-number.json, nothing is sent. Consent is given the way a person does.
click_text "Open example"
wait 20
key ctrl+k
wait 6
text ask claude
wait 8
key Enter
wait 10
expect "Test replay"
scroll 250 300 -300
wait 4
click_text "Whole project"
wait 4
click_text "I have read this and agree"
wait 4
click_text "Turn Claude on" Button
wait 8
expect "Claude is on"
shot ask-claude-on
check_layout
click_text "" MultilineTextInput
wait 3
text Fix my wire numbers
click_text Send Button
wait 60
expect "Suggested change"
expect "Number the wire from"
expect "and its net L1-77"
expect "Replaces the current number of the wire from"
shot ask-claude-wire-card
check_layout
click_text Apply Button
wait 10
expect "Applied"
shot ask-claude-wire-applied
check_layout
