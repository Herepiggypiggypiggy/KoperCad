@title Crane template: New from template, fill a field, the cover page fills in
@area Schematic
@sizes 1366x768
wait 20
key ctrl+k
wait 6
text new from template overhead crane
wait 8
shot menu-new-from-template
key Return
wait 12
shot options-window
click_text "Create project"
wait 30
shot template-opened
expect "New crane project"
key ctrl+k
wait 6
text project settings
wait 8
key Return
wait 12
shot project-settings
click_text "Drawing standard"
wait 6
click_text Open
wait 12
shot project-information
tree Customer
click 1270 277
text Acme Cranes
key Tab
wait 8
shot customer-typed
click_text Done
wait 10
click_text Pages
wait 10
click 165 185
text Front
wait 10
shot pages-filtered
click 200 237
wait 20
shot cover-title
click 200 295
wait 20
shot cover-structure
check_layout
