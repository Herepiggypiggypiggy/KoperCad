@title Parts table import (mapping, preview, add)
@area Parts
# A made-up German price list (Windows-1252, semicolons, units in headers); the native file dialog is answered by the harness.
open_starter_example
wait 20
answer_dialog qa/fixtures/parts/price-list-de.csv
click_text File
wait 4
click_text "Import..."
wait 4
text "table"
wait 4
click_text "Import parts table"
wait 2
click_text "Import" Button #1
wait 20
shot columns
check_layout
check_blank columns
expect "Import parts from price-list-de.csv"
expect "Nennstrom [A]"
click_text Rows Button
wait 10
shot rows
check_layout
expect "Not imported"
# The sentence is the popover of the row triangle.
click_text "Warning: Check this row" Button #2
wait 6
expect "not a possible size"
shot row-popover
click_text "Warning: Check this row" Button #2
wait 6
click_text "Add 4 parts to the catalog"
wait 20
shot added
