@title Live current paths in the Light look
@area Schematic
@sizes 1366x768
# Same route as 338, in the Light look: the dashes must stay visible on the lit wires.
click_text "Open example"
wait 20
key ctrl+k
wait 6
text preferences
wait 8
key Enter
wait 10
click_text Light
wait 10
key Escape
wait 6
key shift+l
wait 20
tree Go
try click_text "Go to page 2 Control circuit"
wait 20
mouse_down 75 397
wait 20
shot paths-light
expect "Current paths"
check_layout
mouse_up 75 397
wait 6
