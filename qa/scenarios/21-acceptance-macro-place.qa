@title Place macro: a click on the macro's name picks it
@area Schematic
# Acceptance A-01: rows swallowed clicks on their own text (selectable labels), so the
# macro list could only be picked by clicking the thin padding at the row's edge.
click_text "New project"
wait 20
key ctrl+k
text "motor starter dol"
wait 5
key Enter
wait 10
expect "Pick a macro to see what it will do."
click_text "Motor starter DOL" Label
wait 10
expect_not "Pick a macro to see what it will do."
expect "Keep the macro's wire numbers"
shot macro-picked
click_text Place Button #2
wait 20
expect_scene "-K1"
shot macro-placed
