@title Example gallery: motor control centre
@area Examples
# File > Examples > Open example: motor control centre. Every page (reached with Ctrl+K), the cabinet, 3D and the parts list.
fresh
wait 10
key ctrl+k
wait 6
text motor control centre
wait 8
key Enter
wait 40
expect "Incoming supply and 24 V"
shot mcc-page-1
check_blank mcc-page-1
check_layout
key ctrl+k
wait 6
text Direct-on-line feeders
wait 8
key Enter
wait 15
expect "Direct-on-line feeders"
shot mcc-page-2
key ctrl+k
wait 6
text Star-delta feeder
wait 8
key Enter
wait 15
expect "Star-delta feeder"
shot mcc-page-3
key ctrl+k
wait 6
text Control: direct-on-line feeders
wait 8
key Enter
wait 15
expect "Control: direct-on-line feeders"
shot mcc-page-4
key ctrl+k
wait 6
text Control: star-delta feeder
wait 8
key Enter
wait 15
expect "Control: star-delta feeder"
shot mcc-page-5
click_text "Cabinet"
wait 20
shot mcc-cabinet
check_blank mcc-cabinet
click_text "3D"
wait 30
shot mcc-3d
click_text "Reports"
wait 20
shot mcc-reports
