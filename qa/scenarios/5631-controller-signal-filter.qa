@title Controller card: filter the signals by text, active and unbound
@area Live
@sizes 1366x768
# Lane C3. The filter bar sits above the signal list on the Controller card: controller picker,
# search box, Active, Unbound, Clear. The fixture has one radio with 15 signals; 9 drive nothing.
open qa/fixtures/radio-hoist.novo
wait 20
key shift+l
wait 20
click_text "Controller…"
wait 20
scroll 1100 500 -900
wait 10
shot filter-bar
expect "This controller"
expect "Signals (1 of 15 high)"
click_text "Unbound" Checkbox
wait 10
shot only-unbound
expect "Signals (9 of 15 shown, 0 high)"
check_layout
click_text "Clear"
wait 10
expect "Signals (1 of 15 high)"
click_text "Active" Checkbox
wait 10
shot only-active
expect "Signals (1 of 15 shown, 1 high)"
check_layout
