@title Wire ends: ring lug and sleeve text on a wire show in the Bench output crimp list
@area Schematic
@sizes 1920x1080
# Select a wire, Inspector > Wire ends: End A ring M5 and a sleeve text; Reports > Bench output > Ferrules lists "Lugs to crimp".
open_starter_example
wait 30
click 24 82
wait 10
# The Pages panel is closed so the sheet keeps its place and the Inspector has room.
click 270 73
wait 20
click 464 390
wait 15
expect "Wire ends"
expect "Sleeve text"
expect "End A"
shot inspector-wire-ends
check_layout
click_text Proposed #1
wait 5
click_text "Ring lug"
wait 8
click 1747 368
text M5
key Tab
wait 5
click 1700 422
text L1.1-U
key Tab
wait 8
shot ring-m5-and-sleeve-set
check_layout
click_text Reports #1
wait 5
click_text "Bench output..."
wait 20
scroll 1750 300 -300
wait 5
click_text Ferrules
wait 40
expect "Lugs to crimp"
expect "Ring lug M5"
scroll 1750 300 -600
wait 10
shot lugs-to-crimp
check_layout
click_text Labels
wait 8
shot labels-tab
