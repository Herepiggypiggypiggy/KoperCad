@title Bench: the readiness sentences are yellow triangle chips with the sentence in a popover (1366x768)
@area Reports
@sizes 1366x768
# T12: "Before you print" shows triangle chips (wires without size, lengths estimated) instead of sentences; a click opens the sentence; Escape closes it; the fix button stays.
open_starter_example
wait 20
click_text Reports
wait 5
click_text "Bench output..."
wait 20
expect "Wires without size"
expect "Lengths estimated"
expect_not "21 of 25 wires to cut have no cross-section"
shot bench-chips
check_layout
click_text "Wires without size" Button
wait 8
expect "Wires without a cross-section get no ferrule"
shot bench-chip-popover
check_layout
key Escape
wait 6
expect_not "Wires without a cross-section get no ferrule"
shot bench-chip-closed
