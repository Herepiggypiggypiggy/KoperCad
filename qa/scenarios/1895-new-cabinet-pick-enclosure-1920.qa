@title New cabinet: pick an enclosure card, the cabinet gets its plate and the estimate line
@sizes 1920x1080
@area Cabinet
# Where the user finds it: Outline > New cabinet > Enclosure (cards, search, state lines).
user_catalog qa/fixtures/enclosure-parts.json
fresh
key ctrl+n
wait 20
click_text Cabinet #1
wait 20
click_text "New cabinet..." Button
wait 10
expect "Demo TS-600x1800x500"
shot a-cards
click_text "Demo TS-600x1800x500"
wait 6
expect "(estimate)"
shot b-picked
check_layout
key Enter
wait 20
shot c-created
click_text Cabinet #1
wait 20
shot d-cabinet-view
key ctrl+z
wait 10
shot e-after-undo
expect "No panel yet"
