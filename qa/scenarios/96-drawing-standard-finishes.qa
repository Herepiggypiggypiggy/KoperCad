@title The Drawing standard lesson ticks on a real click of NFPA
@area Learn
@sizes 1366x768
key ctrl+k
wait 4
text drawing standard
wait 6
click_text "IEC or NFPA: the Drawing Standard"
wait 40
try click_text "Next"
wait 30
try click_text "Do it for me"
wait 30
shot step3-ring-on-nfpa
expect "Choose NFPA 79"
click 603 266
wait 30
shot step3-after-click
expect_not "Choose NFPA 79"
check_layout
