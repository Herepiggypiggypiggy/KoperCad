@title Assign parts to all devices with a long device list scrolls and keeps its buttons
@sizes 1366x768 1920x1080
@area Parts
# The list has its own scroll area: the footer buttons (Assign N parts, Cancel) stay visible however many devices there are.
fresh
click_text "New project"
wait 20
key ctrl+k
text "Motor starter DOL"
wait 10
key Return
wait 20
click_text Place #2
wait 20
key Escape
key ctrl+k
text "Frequency converter drive"
wait 10
key Return
wait 20
click_text Place #2
wait 20
key Escape
key ctrl+k
text "Power supply 24 V"
wait 10
key Return
wait 20
click_text Place #2
wait 20
key Escape
key ctrl+k
text "PLC network with switch"
wait 10
key Return
wait 20
click_text Place #2
wait 20
key Escape
key ctrl+k
text "Assign parts to all"
wait 10
key Return
wait 20
expect "Assign parts to all devices"
shot long-list-top
scroll 683 450 -300
wait 5
shot long-list-scrolled
expect "Cancel"
expect "Tick sure parts"
check_layout
