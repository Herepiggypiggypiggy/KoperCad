@title Work cards: the Build order strip prints the step on screen as one card
@area 3D
# 3D > Layers > Build order: on a part step the strip has "Print this step", which writes that step's work card as one PDF page next to the project. At the start (no part) the button is not offered.
click_text "Open example"
wait 20
click_text 3D #1
wait 40
click_text "Layers"
wait 8
click_text "Build order"
wait 8
key Escape
wait 30
expect_not "Print this step"
click_text "Next"
wait 12
click_text "Next"
wait 12
shot step-2-print-this-step
expect "Print this step"
check_layout
click_text "Print this step"
wait 40
shot after-print
expect_file "~/Documents/KoperCAD/*work card R2.pdf" 2000
keep_file "~/Documents/KoperCAD/*work card R2.pdf"
