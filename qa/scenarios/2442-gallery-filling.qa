@title Example gallery: bottle filling line (large)
@area Examples
# File > Templates and examples... > Examples shows the row and its text; then the example opens (Ctrl+K), two pages, the cabinet, 3D and the live view.
fresh
wait 10
click_text "Open example"
wait 20
click_text File #1
wait 6
click_text "Templates and examples..."
wait 10
text filling
wait 8
click_text "Open filling line example"
wait 6
shot filling-gallery-row
expect "Illustration only"
expect "Large: a filling line"
check_layout
key Escape
wait 6
key ctrl+k
wait 6
text Open example: bottle filling line
wait 8
key Enter
wait 40
expect "Incoming supply and 24 V"
shot filling-first-view
check_blank filling-first-view
check_layout
key ctrl+k
wait 6
text Filler pump drive
wait 8
key Enter
wait 15
expect "Filler pump drive"
shot filling-page-2
key ctrl+k
wait 6
text PLC and cards
wait 8
key Enter
wait 15
expect "PLC and cards"
shot filling-page-3
click_text "Cabinet"
wait 20
shot filling-cabinet
check_blank filling-cabinet
click_text "3D"
wait 30
shot filling-3d
click_text "Schematic"
wait 15
key shift+l
wait 20
shot filling-live
check_layout
