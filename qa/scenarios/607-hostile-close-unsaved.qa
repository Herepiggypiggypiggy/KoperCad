@title Hostile: close and new with unsaved changes ask, and Cancel keeps the edit
@area Hostile
click_text "Open example"
wait 20
key q
wait 4
text contactor
wait 6
key Enter
wait 6
click 700 300
wait 6
key Escape
shot edited
key ctrl+k
wait 6
text close project
wait 8
key Enter
wait 15
shot close-prompt
tree closeprompt
# Closing asks; Cancel keeps the edit on screen.
expect "Save changes?"
click_text Cancel
wait 10
expect_not "Save changes?"
expect_scene K2
shot cancelled-close
key ctrl+n
wait 15
shot new-prompt
expect "Save changes?"
click_text Cancel
wait 10
expect_scene K2
key ctrl+o
wait 10
shot open-prompt
key Escape
wait 8
check_layout
