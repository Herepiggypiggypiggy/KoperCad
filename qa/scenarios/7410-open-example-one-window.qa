@title Every Open example entry point opens the Templates and examples window, which keeps a stable width
@area Layout
# Start panel button, File > Open > Open example and Ctrl+K "open example" all open
# the same window (not the motor starter directly). The window must not grow while open.
click_text "Open example"
wait 20
shot start-button
expect "Choose a template or example"
check_layout
wait 120
shot start-button-later
expect "Choose a template or example"
check_layout
key Escape
wait 6
expect_not "Choose a template or example"
key ctrl+k
wait 6
text open example
wait 8
key Enter
wait 20
shot palette
expect "Choose a template or example"
check_layout
key Escape
wait 6
open_starter_example
click_text File #1
wait 6
click_text Open #1
wait 6
click_text "Open example"
wait 20
shot file-menu
expect "Choose a template or example"
check_layout
wait 120
shot file-menu-later
check_layout
