@title Circuit library: the bridge travel two-motor circuit is found and placed
@area Schematic
# Batch 3 of the circuit library: a new circuit is found by search and placed on the page.
click_text "New project"
wait 20
key ctrl+k
text "place macro"
wait 5
key Enter
wait 10
click 237 94
text "two motors"
wait 5
expect "Circuits/4 Travel drives"
click_text "Bridge travel two motors on one drive" Label
wait 10
expect "Mounting view"
shot bridge2-picked
click_text Place Button
wait 30
expect_scene "-Q3"
shot bridge2-placed
