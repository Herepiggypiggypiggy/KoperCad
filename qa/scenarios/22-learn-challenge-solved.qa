@title Challenge lesson repaired by hand ends on Solved
@area Learn
@sizes 1366x768
# Pin positions are for 1366x768 (at 1920x1080 the page panel moves the sheet), so this one runs at that size only.
key ctrl+k
wait 4
text hold in
wait 6
click_text "The motor will not hold in"
wait 40
key shift+l
wait 40
click_text Connect
wait 6
click 345 399
wait 4
move 320 399
wait 4
click 291 399
wait 10
shot repaired
click_text "Hold to press" #2
wait 20
shot after-start
click_text "Hold to press" #1
wait 40
shot end-solved
expect "Solved"
expect_not "Shown, not solved"
check_layout
