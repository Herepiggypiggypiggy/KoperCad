@title Ask Claude shows a Markdown answer as formatted text, not as asterisks and pipes
@sizes 1366x768 1920x1080 1024x600
@area Assistant
@env KOPERCAD_AI_REPLAY=qa/replay/markdown-answer.json
@env ANTHROPIC_API_KEY=sk-ant-api03-qa-replay-key-0000000000
# Hardware test KC-16: answers showed **bold** and table pipes. The answer comes from qa/replay/markdown-answer.json, nothing is sent.
click_text "New project"
wait 20
key ctrl+k
wait 6
text ask claude
wait 8
key Enter
wait 10
scroll 250 300 -300
wait 4
click_text "Whole project"
wait 4
scroll 250 300 -3000
wait 4
click_text "I have read this and agree"
wait 4
click_text "Turn Claude on" Button
wait 8
expect "Claude is on"
click_text "" MultilineTextInput
wait 3
text Number the wires.
click_text Send Button
wait 120
expect "Wire numbering result"
expect "13 nets"
expect_not "**"
expect_not "|---"
shot markdown-answer
check_layout
