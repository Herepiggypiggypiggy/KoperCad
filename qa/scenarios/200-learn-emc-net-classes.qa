@title Lesson walk: emc-net-classes (every step, Do it for me or Next)
@area Learn
# Starts the lesson from the palette and plays each step as a learner would: an action step with Do it for me, a reading step with Next. A picture and a layout check after each step.
key ctrl+k
wait 4
text interference
wait 6
click_text "Interference: give every wire its class"
wait 40
shot 01-why
check_layout
try click_text "Next"
wait 20
shot 02-switch-on
check_layout
try click_text "Do it for me"
wait 30
shot 03-read-colours
check_layout
try click_text "Next"
wait 20
shot 04-keep-one
check_layout
try click_text "Do it for me"
wait 30
shot 05-pick-motor-wire
check_layout
try click_text "Do it for me"
wait 30
shot 06-shield-core
check_layout
try click_text "Do it for me"
wait 30
shot 07-set-class
check_layout
try click_text "Do it for me"
wait 30
shot 08-undo
check_layout
try click_text "Do it for me"
wait 30
shot 09-honest
check_layout
try click_text "Next"
wait 20
shot 10-close
check_layout
try click_text "Do it for me"
wait 30
shot end
check_layout
