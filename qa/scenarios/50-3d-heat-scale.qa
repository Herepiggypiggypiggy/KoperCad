@title 3D Heat: hold the colour range, then go back to Auto
@area 3D
# Scale menu in the Heat strip: Hold this range keeps the range now shown; Auto goes back to ambient to the hottest cell.
open_starter_example
wait 20
click_text 3D #1
wait 30
click_text Heat #1
wait 20
# Heat starts a run by itself (Thorough, Auto on) and greys out the Quality row: stop it, switch Auto off, stop again, then run Quick.
click_text Cancel
wait 10
click_text Auto #1
wait 10
wait 30
try click_text Cancel
wait 30
try click_text Cancel
wait 20
click_text "Settings for the next run"
wait 10
click_text Quick
wait 10
click_text Simulate #2
wait 600
click_text Scale
wait 20
expect "Hold this range"
shot scale-menu
click_text "Hold this range"
wait 20
expect "Scale: held"
shot scale-held
click_text Auto
wait 20
expect_not "Scale: held"
shot scale-auto
check_layout
