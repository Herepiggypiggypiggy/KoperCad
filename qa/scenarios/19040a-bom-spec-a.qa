@title PR1904: BOM Enclosure and Cabinet sheet, spec A
@area Reports
@sizes 1366x768 1920x1080
# Synthetic enclosure record, catalogue numbers only.
open qa/fixtures/cabinet-spec-a.novo
wait 20
key ctrl+k
text Bill of materials
key enter
wait 15
shot bom-top
expect "Enclosure Synthetic, 600 x 800 x 300 mm"
expect "Mounting plate 450 x 450 mm"
check_layout
key ctrl+f
text Estimate
wait 5
shot bom-cabinet-sheet
expect "Estimate from catalogue data"
check_layout
