@title Three-phase supply is fed when placed after the starter
@area Live
# Star-delta starter, then the Three-phase supply. The supply brings its own
# L1 L2 L3 N PE feeds, so Live view no longer says there is no supply, and the
# status line names the next step (wire the outputs to the starter).
fresh
click_text "New project"
wait 20
key ctrl+k
text "Star-delta starter"
wait 10
key Return
wait 20
click_text Place #2
wait 20
key ctrl+k
text "Three-phase supply"
wait 10
key Return
wait 20
shot 01-picked
click_text Place #2
wait 20
expect "N PE fed"
expect "now wire its outputs"
shot 02-placed
key shift+l
wait 20
expect_not "No supply is defined"
shot 03-live
