 /// Handles to the objects of the Gate 1 project.
@@ -185,6 +185,9 @@ fn build(tx: &mut Tx<'_>) -> Result<MotorStarter> {
         .enumerate()
     {
         let terminal = tx.add_terminal(x1, name)?;
+        if i == 3 {
+            tx.update::<Terminal>(terminal, |t| t.kind = TerminalKind::ProtectiveEarth)?;
+        }
         let key = if i == 3 {
             "iec/terminals/terminal_pe"
         } else {
diff --git a/crates/novo-tests/tests/gate1_motor_starter.rs b/crates/novo-tests/tests/gate1_motor_starter.rs
index cadc019..535a141 100644
--- a/crates/novo-tests/tests/gate1_motor_starter.rs
+++ b/crates/novo-tests/tests/gate1_motor_starter.rs
@@ -164,6 +164,26 @@ fn designations_read_like_a_drawing() {
     );
 }
 
+#[test]
+fn terminal_kinds_match_their_use() {
+    let (doc, s) = starter();
+    let kinds: Vec<(String, TerminalKind)> = doc
+        .project()
+        .terminals_of_strip(s.x1)
+        .into_iter()
+        .map(|t| (t.name.clone(), t.kind))
+        .collect();
+    assert_eq!(
+        kinds,
+        [
+            ("1".to_string(), TerminalKind::Feedthrough),
+            ("2".to_string(), TerminalKind::Feedthrough),
+            ("3".to_string(), TerminalKind::Feedthrough),
+            ("PE".to_string(), TerminalKind::ProtectiveEarth),
+        ]
+    );
+}
