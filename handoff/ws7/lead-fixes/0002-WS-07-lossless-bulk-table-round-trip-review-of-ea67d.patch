+fn set_property(doc: &mut Document, target: DeviceId, key: &str, value: Value) {
+    doc.execute(novo_core::Command::SetProperty {
+        target: target.into(),
+        key: key.into(),
+        value: Some(value),
+    })
+    .unwrap();
+}
