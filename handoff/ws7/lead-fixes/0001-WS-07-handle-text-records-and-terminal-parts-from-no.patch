From: local <x@x>
Date: Wed, 14 Oct 2026 17:45:26 +0000
Subject: [PATCH 1/2] WS-07: handle text records and terminal parts from
 novo-core #35

Texts carry no part: the property sheet names them ("Text Main supply",
"text" in counts) and shows no Part row. Terminals now carry their own
article, so the sheet shows a Part row for them. missing_parts keeps
listing devices and cables only: a terminal without its own part is
covered by its strip device.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01DZ68tTULUv7Uhe8ecKbC47
---
 crates/novo-parts/src/assign.rs  |  3 ++
 crates/novo-parts/src/sheet.rs   |  8 +++++
 crates/novo-parts/tests/parts.rs | 51 ++++++++++++++++++++++++++++++++
 3 files changed, 62 insertions(+)

diff --git a/crates/novo-parts/src/assign.rs b/crates/novo-parts/src/assign.rs
index b1d864e..4fd2c01 100644
--- a/crates/novo-parts/src/assign.rs
+++ b/crates/novo-parts/src/assign.rs
@@ -233,6 +233,9 @@ pub fn remove_unused_parts(project: &Project) -> Option<Command> {
 /// Devices and cables that have no part yet, in tag order. This is the
 /// WS-07 done criterion for the Gate 1 project ("every device carries a
 /// real part") and the input for the design check "missing parts" (WS-14).
+///
+/// Terminals are not listed: a terminal without its own part is covered by
+/// its strip device, which is listed here when it has none either.
 pub fn missing_parts(project: &Project) -> Vec<AnyId> {
     let mut devices: Vec<&Device> = project.devices().filter(|d| d.parts.is_empty()).collect();
     devices.sort_by(|a, b| novo_core::natural_cmp(&a.tag.to_string(), &b.tag.to_string()));
diff --git a/crates/novo-parts/src/sheet.rs b/crates/novo-parts/src/sheet.rs
index c6a00fe..4f3e3d3 100644
--- a/crates/novo-parts/src/sheet.rs
+++ b/crates/novo-parts/src/sheet.rs
@@ -526,6 +526,7 @@ fn noun(kind: EntityKind) -> &'static str {
         EntityKind::Terminal => "terminal",
         EntityKind::Cable => "cable",
         EntityKind::Part => "part",
+        EntityKind::Text => "text",
     }
 }
 
@@ -541,6 +542,9 @@ fn assigned_parts(record: &Record) -> Option<Vec<PartId>> {
     match record {
         Record::Device(d) => Some(d.parts.clone()),
         Record::Cable(c) => Some(c.part.into_iter().collect()),
+        Record::Terminal(t) => Some(t.part.into_iter().collect()),
+        // Pages, symbols, wires, junctions, potentials, parts and texts
+        // carry no part.
         _ => None,
     }
 }
@@ -794,6 +798,10 @@ impl PropertySheet {
                 },
                 Record::Symbol(s) => format!("Symbol {}", s.symbol.0),
                 Record::Junction(_) => "Junction".into(),
+                Record::Text(t) => match &t.content {
+                    novo_core::TextContent::Literal { text } => format!("Text {text}"),
+                    _ => "Text".into(),
+                },
             };
         }
         let kind = records[0].kind();
diff --git a/crates/novo-parts/tests/parts.rs b/crates/novo-parts/tests/parts.rs
index a5ceed1..c1739b9 100644
--- a/crates/novo-parts/tests/parts.rs
+++ b/crates/novo-parts/tests/parts.rs
@@ -645,3 +645,54 @@ fn certain_parts_are_assigned_and_the_rest_proposed() {
     );
     assert!(doc.project().device(gate.k1).unwrap().parts.is_empty());
 }
+
+#[test]
+fn texts_have_no_part_and_terminals_show_theirs() {
+    let mut doc = Document::default();
+    let gate = motor_starter(&mut doc).unwrap();
+    let created = doc
+        .execute(novo_core::Command::AddText {
+            page: gate.main_page,
+            content: novo_core::TextContent::Literal {
+                text: "Main supply".into(),
+            },
+            placement: Default::default(),
+            attached_to: None,
+        })
+        .unwrap()
+        .created;
+    let [AnyId::Text(note)] = created[..] else {
+        panic!("{created:?}")
+    };
+    let sheet = PropertySheet::build(doc.project(), &[note.into()]);
+    assert_eq!(sheet.title(), "Text Main supply");
+    assert!(sheet.row(&RowKey::Part).is_none());
+    let sheet = PropertySheet::build(doc.project(), &[note.into(), gate.k1.into()]);
+    assert_eq!(sheet.title(), "2 objects");
+    assert!(sheet.row(&RowKey::Part).is_none());
+
+    // A terminal carries its own article (novo-core #35).
+    let k1_part = doc.project().device(gate.k1).unwrap().parts[0];
+    let mut terminal = doc.project().terminals().next().unwrap().clone();
+    let sheet = PropertySheet::build(doc.project(), &[terminal.id.into()]);
+    assert_eq!(
+        sheet.row(&RowKey::Part).map(|r| &r.value),
+        Some(&RowValue::Same(String::new()))
+    );
+    terminal.part = Some(k1_part);
+    let id = terminal.id;
+    doc.execute(novo_core::Command::Replace {
+        record: Record::Terminal(terminal),
+    })
+    .unwrap();
+    let sheet = PropertySheet::build(doc.project(), &[id.into()]);
+    let RowValue::Same(label) = &sheet.row(&RowKey::Part).unwrap().value else {
+        panic!("one part")
+    };
+    assert!(label.starts_with("Siemens 3RT2016"), "{label}");
+    // A part used only by a terminal is not unused.
+    let devices: Vec<DeviceId> = doc.project().devices().map(|d| d.id).collect();
+    let command = clear_parts(doc.project(), &devices);
+    run(&mut doc, command);
+    assert!(!novo_parts::unused_parts(doc.project()).contains(&k1_part));
+}
