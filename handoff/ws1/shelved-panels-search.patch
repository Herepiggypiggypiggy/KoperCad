+//! What the object panels list, what search finds and where an object is
+//! drawn: read-only queries over the project, kept apart from the UI so they
+//! can be tested without a window.
+
+use std::collections::BTreeMap;
+
+use novo_core::{AnyId, PageId, Project, SymbolRole, Value};
+use serde::{Deserialize, Serialize};
+
+/// The object panels in the left dock, each with its own name.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash, Serialize, Deserialize)]
+pub enum Panel {
+    #[default]
+    Pages,
+    Devices,
+    Terminals,
+    Cables,
+    Potentials,
+}
+
+impl Panel {
+    pub const ALL: [Panel; 5] = [
+        Panel::Pages,
+        Panel::Devices,
+        Panel::Terminals,
+        Panel::Cables,
+        Panel::Potentials,
+    ];
+
+    pub fn label(self) -> &'static str {
+        match self {
+            Panel::Pages => "Pages",
+            Panel::Devices => "Devices",
+            Panel::Terminals => "Terminals",
+            Panel::Cables => "Cables",
+            Panel::Potentials => "Potentials",
+        }
+    }
+}
+
+/// One line in an object panel or the search list.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Row {
+    pub id: AnyId,
+    /// The tag or name, which search matches first.
+    pub text: String,
+    /// Description or other secondary text, shown weaker.
+    pub detail: String,
+}
+
+/// The rows of `panel`, in the order a reader expects: pages in page order,
+/// everything else by name.
+pub fn rows(project: &Project, panel: Panel) -> Vec<Row> {
+    let mut rows: Vec<Row> = match panel {
+        Panel::Pages => {
+            return project
+                .pages_in_order()
+                .into_iter()
+                .map(|p| Row {
+                    id: p.id.into(),
+                    text: p.name.clone(),
+                    detail: p.title.clone(),
+                })
+                .collect();
+        }
+        Panel::Devices => project
+            .devices()
+            .filter(|d| d.kind != novo_core::DeviceKind::TerminalStrip)
+            .map(|d| Row {
+                id: d.id.into(),
+                text: d.tag.to_string(),
+                detail: d.description.clone(),
+            })
+            .collect(),
+        Panel::Terminals => {
+            // Strips with their terminals, in strip order.
+            let mut strips: Vec<_> = project
+                .devices()
+                .filter(|d| d.kind == novo_core::DeviceKind::TerminalStrip)
+                .collect();
+            strips.sort_by_cached_key(|d| d.tag.to_string());
+            let mut rows = Vec::new();
+            for strip in strips {
+                rows.push(Row {
+                    id: strip.id.into(),
+                    text: strip.tag.to_string(),
+                    detail: strip.description.clone(),
+                });
+                for t in project.terminals_of_strip(strip.id) {
+                    rows.push(Row {
+                        id: t.id.into(),
+                        text: format!("{}:{}", strip.tag, t.name),
+                        detail: String::new(),
+                    });
+                }
+            }
+            return rows;
+        }
+        Panel::Cables => project
+            .cables()
+            .map(|c| Row {
+                id: c.id.into(),
+                text: c.tag.to_string(),
+                detail: join_nonempty([c.description.clone(), format!("{} cores", c.cores.len())]),
+            })
+            .collect(),
+        Panel::Potentials => project
+            .potentials()
+            .map(|p| Row {
+                id: p.id.into(),
+                text: p.name.clone(),
+                detail: join_nonempty([
+                    format!("{:?}", p.kind),
+                    p.voltage.map(|v| format!("{v} V")).unwrap_or_default(),
+                ]),
+            })
+            .collect(),
+    };
+    rows.sort_by(|a, b| natural_cmp(&a.text, &b.text));
+    rows
+}
+
+/// Every object worth finding by name, across all panels.
+pub fn searchable(project: &Project) -> Vec<(Panel, Row)> {
+    Panel::ALL
+        .iter()
+        .flat_map(|&panel| rows(project, panel).into_iter().map(move |r| (panel, r)))
+        .collect()
+}
+
+/// A short name for any object: its tag, designation or name.
+pub fn name(project: &Project, id: AnyId) -> String {
+    match id {
+        AnyId::Page(p) => project
+            .page(p)
+            .map(|p| format!("Page {}", p.name))
+            .unwrap_or_default(),
+        AnyId::Device(d) => project
+            .device(d)
+            .map(|d| d.tag.to_string())
+            .unwrap_or_default(),
+        AnyId::Terminal(t) => project.terminal_designation(t).unwrap_or_default(),
+        AnyId::Cable(c) => project
+            .cable(c)
+            .map(|c| c.tag.to_string())
+            .unwrap_or_default(),
+        AnyId::Potential(p) => project
+            .potential(p)
+            .map(|p| p.name.clone())
+            .unwrap_or_default(),
+        AnyId::Symbol(s) => match owner(project, id) {
+            owner if owner != id => name(project, owner),
+            _ => project
+                .symbol(s)
+                .map(|s| s.symbol.0.clone())
+                .unwrap_or_default(),
+        },
+        AnyId::Wire(w) => project
+            .wire(w)
+            .and_then(|w| w.number.clone())
+            .map(|n| format!("Wire {n}"))
+            .unwrap_or_else(|| "Wire".to_owned()),
+        AnyId::Junction(_) => "Junction".to_owned(),
+        AnyId::Part(p) => project
+            .part(p)
+            .map(|p| p.order_number.clone())
+            .unwrap_or_default(),
+    }
+}
+
+/// The object a user means when they pick a drawn item: a device or
+/// terminal for its symbol, the item itself otherwise.
+pub fn owner(project: &Project, id: AnyId) -> AnyId {
+    let AnyId::Symbol(s) = id else {
+        return id;
+    };
+    match project.symbol(s).map(|s| &s.role) {
+        Some(SymbolRole::Device { device, .. }) => (*device).into(),
+        Some(SymbolRole::Terminal { terminals }) if terminals.len() == 1 => terminals[0].into(),
+        _ => id,
+    }
+}
+
+/// Where an object appears in the drawing: one entry per page, in page
+/// order, with the drawn items on it.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Place {
+    pub page: PageId,
+    pub items: Vec<AnyId>,
+}
+
+pub fn places(project: &Project, id: AnyId) -> Vec<Place> {
+    let drawn: Vec<(PageId, AnyId)> = match id {
+        AnyId::Page(p) => {
+            return project
+                .page(p)
+                .map(|_| {
+                    vec![Place {
+                        page: p,
+                        items: Vec::new(),
+                    }]
+                })
+                .unwrap_or_default();
+        }
+        AnyId::Device(d) => project
+            .symbols_of_device(d)
+            .into_iter()
+            .map(|s| (s.page, s.id.into()))
+            .collect(),
+        AnyId::Terminal(t) => project
+            .symbols_of_terminal(t)
+            .into_iter()
+            .map(|s| (s.page, s.id.into()))
+            .collect(),
+        AnyId::Cable(c) => project
+            .cable(c)
+            .into_iter()
+            .flat_map(|c| c.cores.iter().filter_map(|core| core.wire))
+            .filter_map(|w| project.wire(w))
+            .map(|w| (w.page, w.id.into()))
+            .collect(),
+        AnyId::Potential(p) => {
+            let netlist = project.netlist();
+            netlist
+                .nets_with_potential(p)
+                .flat_map(|net| net.wires.iter())
+                .filter_map(|&w| project.wire(w))
+                .map(|w| (w.page, w.id.into()))
+                .collect()
+        }
+        AnyId::Symbol(s) => project
+            .symbol(s)
+            .map(|s| (s.page, id))
+            .into_iter()
+            .collect(),
+        AnyId::Wire(w) => project.wire(w).map(|w| (w.page, id)).into_iter().collect(),
+        AnyId::Junction(j) => project
+            .junction(j)
+            .map(|j| (j.page, id))
+            .into_iter()
+            .collect(),
+        AnyId::Part(part) => project
+            .devices()
+            .filter(|d| d.parts.contains(&part))
+            .flat_map(|d| project.symbols_of_device(d.id))
+            .map(|s| (s.page, s.id.into()))
+            .collect(),
+    };
+    let order: BTreeMap<PageId, usize> = project
+        .pages_in_order()
+        .iter()
+        .enumerate()
+        .map(|(i, p)| (p.id, i))
+        .collect();
+    let mut by_page: BTreeMap<usize, Place> = BTreeMap::new();
+    for (page, item) in drawn {
+        let Some(&index) = order.get(&page) else {
+            continue;
+        };
+        let place = by_page.entry(index).or_insert_with(|| Place {
+            page,
+            items: Vec::new(),
+        });
+        if !place.items.contains(&item) {
+            place.items.push(item);
+        }
+    }
+    by_page.into_values().collect()
+}
+
+/// Name and value pairs for the properties panel, the fields people look
+/// for most first, then the object's free-form properties by name.
+pub fn fields(project: &Project, id: AnyId) -> Vec<(String, String)> {
+    let mut out: Vec<(String, String)> = Vec::new();
+    let mut add = |k: &str, v: String| {
+        if !v.is_empty() {
+            out.push((k.to_owned(), v));
+        }
+    };
+    let pages = |id: AnyId| {
+        places(project, id)
+            .iter()
+            .filter_map(|p| project.page(p.page).map(|p| p.name.clone()))
+            .collect::<Vec<_>>()
+            .join(", ")
+    };
+    let properties = match id {
+        AnyId::Page(p) => {
+            let Some(p) = project.page(p) else {
+                return Vec::new();
+            };
+            add("Name", p.name.clone());
+            add("Title", p.title.clone());
+            add("Kind", format!("{:?}", p.kind));
+            add("Format", format!("{:?}", p.format));
+            &p.properties
+        }
+        AnyId::Device(d) => {
+            let Some(d) = project.device(d) else {
+                return Vec::new();
+            };
+            add("Tag", d.tag.to_string());
+            add("Description", d.description.clone());
+            add("Pages", pages(id));
+            let parts: Vec<String> = d
+                .parts
+                .iter()
+                .filter_map(|&p| project.part(p))
+                .map(|p| format!("{} {}", p.manufacturer, p.order_number))
+                .collect();
+            add("Part", parts.join(", "));
+            add("Kind", format!("{:?}", d.kind));
+            &d.properties
+        }
+        AnyId::Terminal(t) => {
+            let Some(term) = project.terminal(t) else {
+                return Vec::new();
+            };
+            add(
+                "Designation",
+                project.terminal_designation(t).unwrap_or_default(),
+            );
+            add("Pages", pages(id));
+            add("Kind", format!("{:?}", term.kind));
+            add("Level", term.level.to_string());
+            if let Some(j) = term.jumper {
+                add("Jumper", j.to_string());
+            }
+            &term.properties
+        }
+        AnyId::Cable(c) => {
+            let Some(c) = project.cable(c) else {
+                return Vec::new();
+            };
+            add("Tag", c.tag.to_string());
+            add("Description", c.description.clone());
+            add("Pages", pages(id));
+            add("Cores", c.cores.len().to_string());
+            if let Some(l) = c.length_m {
+                add("Length", format!("{l} m"));
+            }
+            &c.properties
+        }
+        AnyId::Potential(p) => {
+            let Some(p) = project.potential(p) else {
+                return Vec::new();
+            };
+            add("Name", p.name.clone());
+            add("Pages", pages(id));
+            add("Kind", format!("{:?}", p.kind));
+            if let Some(v) = p.voltage {
+                add("Voltage", format!("{v} V"));
+            }
+            &p.properties
+        }
+        AnyId::Wire(w) => {
+            let Some(w) = project.wire(w) else {
+                return Vec::new();
+            };
+            add("Number", w.number.clone().unwrap_or_default());
+            add("Colour", w.color.clone().unwrap_or_default());
+            if let Some(cs) = w.cross_section_mm2 {
+                add("Cross section", format!("{cs} mm²"));
+            }
+            if let Some((cable, core)) = project.core_of_wire(w.id) {
+                add(
+                    "Cable",
+                    format!("{} core {}", name(project, cable.into()), core + 1),
+                );
+            }
+            &w.properties
+        }
+        AnyId::Symbol(s) => {
+            let Some(s) = project.symbol(s) else {
+                return Vec::new();
+            };
+            add("Symbol", s.symbol.0.clone());
+            &s.properties
+        }
+        AnyId::Part(p) => {
+            let Some(p) = project.part(p) else {
+                return Vec::new();
+            };
+            add("Manufacturer", p.manufacturer.clone());
+            add("Order number", p.order_number.clone());
+            add("Type", p.type_number.clone());
+            add("Description", p.description.clone());
+            &p.properties
+        }
+        AnyId::Junction(_) => return Vec::new(),
+    };
+    for (k, v) in properties {
+        let v = match v {
+            Value::Bool(b) => b.to_string(),
+            Value::Int(i) => i.to_string(),
+            Value::Float(f) => f.to_string(),
+            Value::Text(t) => t.clone(),
+        };
+        out.push((k.clone(), v));
+    }
+    out
+}
+
+fn join_nonempty<const N: usize>(parts: [String; N]) -> String {
+    parts
+        .into_iter()
+        .filter(|s| !s.is_empty())
+        .collect::<Vec<_>>()
+        .join(" · ")
+}
+
+/// Orders "-K2" before "-K10".
+pub fn natural_cmp(a: &str, b: &str) -> std::cmp::Ordering {
+    fn chunks(s: &str) -> Vec<(bool, &str)> {
+        let mut out = Vec::new();
+        let mut start = 0;
+        let bytes = s.as_bytes();
+        for i in 1..=bytes.len() {
+            if i == bytes.len() || bytes[i].is_ascii_digit() != bytes[start].is_ascii_digit() {
+                out.push((bytes[start].is_ascii_digit(), &s[start..i]));
+                start = i;
+            }
+        }
+        out
+    }
+    let (ca, cb) = (chunks(a), chunks(b));
+    for ((da, x), (db, y)) in ca.iter().zip(&cb) {
+        let ord = if *da && *db {
+            let (x, y) = (x.trim_start_matches('0'), y.trim_start_matches('0'));
+            x.len().cmp(&y.len()).then_with(|| x.cmp(y))
+        } else {
+            x.to_lowercase().cmp(&y.to_lowercase())
+        };
+        if ord.is_ne() {
+            return ord;
+        }
+    }
+    ca.len().cmp(&cb.len())
+}
