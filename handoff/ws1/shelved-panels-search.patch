+/// Zooms to the items, or to the whole page when none of them is drawn.
+fn frame_items(canvas: &mut PageCanvas, items: &[AnyId]) {
+    let scene = canvas.scene.scene();
+    let bounds = items
+        .iter()
+        .filter_map(|&id| scene.item_bounds(item_id(id)))
+        .reduce(|a, b| a.union(&b));
+    match bounds {
+        Some(b) => {
+            // Small items would fill the screen; keep some context.
+            let min = Vec2::splat(100.0);
+            let grow = (min - b.size()).max(Vec2::ZERO) * 0.5;
+            let b = Aabb::new(b.min - grow, b.max + grow);
+            canvas.view.viewport.fit(&b, REVEAL_MARGIN);
+        }
+        None => canvas.view.viewport.fit(&scene.bounds(), 24.0),
+    }
