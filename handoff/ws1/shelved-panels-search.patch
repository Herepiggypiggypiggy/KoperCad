+                vec![CableCore::new("1"), CableCore::new("2")],
+            )?;
+            let wires: Vec<_> = tx.project().wires().map(|w| w.id).take(2).collect();
+            tx.assign_core(w1, 0, Some(wires[0]))?;
+            tx.assign_core(w1, 1, Some(wires[1]))?;
+            tx.add_potential("L1", PotentialKind::Line)?;
+            Ok(())
+        })
+        .unwrap();
+        (doc, page)
+    }
+
+    fn texts(rows: &[Row]) -> Vec<&str> {
+        rows.iter().map(|r| r.text.as_str()).collect()
+    }
+
+    #[test]
+    fn panels_list_their_objects_in_natural_order() {
+        let (doc, _) = project();
+        let p = doc.project();
+        assert_eq!(texts(&rows(p, Panel::Pages)), ["1"]);
+        assert_eq!(
+            texts(&rows(p, Panel::Devices)),
+            ["-K1", "-M1", "-Q1", "-S1", "-S2"]
+        );
+        assert_eq!(
+            texts(&rows(p, Panel::Terminals)),
+            ["-X1", "-X1:1", "-X1:2", "-X1:10"]
+        );
+        assert_eq!(texts(&rows(p, Panel::Cables)), ["-W1"]);
+        assert_eq!(rows(p, Panel::Cables)[0].detail, "2 cores");
+        assert_eq!(texts(&rows(p, Panel::Potentials)), ["L1"]);
+    }
+
+    #[test]
+    fn a_device_is_found_on_every_drawing() {
+        let (doc, page) = project();
+        let p = doc.project();
+        let k1 = p.devices_by_tag(&DeviceTag::parse("-K1").unwrap())[0];
+        let found = places(p, k1.into());
+        assert_eq!(found.len(), 1);
+        assert_eq!(found[0].page, page);
+        // Coil, main contacts and the hold contact.
+        assert_eq!(found[0].items.len(), 3);
+        // The main function comes first.
+        let AnyId::Symbol(first) = found[0].items[0] else {
+            panic!("not a symbol");
+        };
+        assert_eq!(p.symbol(first).unwrap().symbol.0, "iec/coil");
+    }
+
+    #[test]
+    fn a_symbol_stands_for_its_device() {
+        let (doc, _) = project();
+        let p = doc.project();
+        let coil = p.symbols().find(|s| s.symbol.0 == "iec/coil").unwrap();
+        let owner = owner(p, coil.id.into());
+        assert!(matches!(owner, AnyId::Device(_)));
+        assert_eq!(name(p, coil.id.into()), "-K1");
+    }
+
+    #[test]
+    fn cable_places_are_its_wires() {
+        let (doc, _) = project();
+        let p = doc.project();
+        let cable = p.cables().next().unwrap().id;
+        assert_eq!(places(p, cable.into())[0].items.len(), 2);
+    }
+
+    #[test]
+    fn device_fields_put_the_common_ones_first() {
+        let (mut doc, _) = project();
+        let k1 = doc
+            .project()
+            .devices_by_tag(&DeviceTag::parse("-K1").unwrap())[0];
+        doc.transact("Note", |tx| {
+            tx.set_property(k1, "Coil voltage", Some("24 V DC".into()))
+        })
+        .unwrap();
+        let f = fields(doc.project(), k1.into());
+        let keys: Vec<&str> = f.iter().map(|(k, _)| k.as_str()).collect();
+        assert_eq!(
+            keys,
+            ["Tag", "Description", "Pages", "Kind", "Coil voltage"]
+        );
+        assert_eq!(f[0].1, "-K1");
+        assert_eq!(f[2].1, "1");
+    }
+
+    #[test]
+    fn potential_places_follow_its_nets() {
+        let (doc, _) = project();
+        let p = doc.project();
+        let l1 = p.potentials().next().unwrap().id;
+        // Not defined anywhere in the drawing yet.
+        assert!(places(p, l1.into()).is_empty());
+    }
+
+    #[test]
+    fn natural_order_compares_numbers_by_value() {
+        let mut v = vec!["-K10", "-K2", "-K1", "-k3"];
+        v.sort_by(|a, b| natural_cmp(a, b));
+        assert_eq!(v, ["-K1", "-K2", "-k3", "-K10"]);
+    }
+}
