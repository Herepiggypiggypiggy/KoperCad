From 00e9cf9e30aab48addbb3e2d57d61491ce8a2907 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 14 Oct 2026 16:44:20 +0000
Subject: [PATCH] novo-app: graphite theme, Nova icon and dark canvas from
 novo-theme

The shell applies novo_theme at start and is dark only, so the theme
actions are gone (old settings files still load). Panel titles use
section_label and the main dialog buttons primary_button. The canvas
draws with the theme's dark canvas palette. The window, exe and
installer use the new Nova icon from assets/branding; the old
placeholder icon is removed.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AYuFPxz6eQReQdtzYKLMmW
---
 .github/workflows/package-windows.yml |   2 +-
 Cargo.lock                            |   2 +
 assets/icon/novoelectric.ico          | Bin 22884 -> 0 bytes
 assets/icon/novoelectric.png          | Bin 9553 -> 0 bytes
 crates/novo-app/Cargo.toml            |   2 +
 crates/novo-app/build.rs              |   4 +-
 crates/novo-app/src/actions.rs        |  21 +------
 crates/novo-app/src/app.rs            |  77 ++++++++++++--------------
 crates/novo-app/src/lib.rs            |   4 +-
 crates/novo-app/src/model_canvas.rs   |  11 +++-
 crates/novo-app/src/settings.rs       |  27 ++-------
 crates/novo-app/src/theme.rs          |  70 +++++++++++++++++++++++
 packaging/windows/novoelectric.iss    |   2 +-
 13 files changed, 129 insertions(+), 93 deletions(-)
 delete mode 100644 assets/icon/novoelectric.ico
 delete mode 100644 assets/icon/novoelectric.png
 create mode 100644 crates/novo-app/src/theme.rs

diff --git a/.github/workflows/package-windows.yml b/.github/workflows/package-windows.yml
index 8577af1..6729fa3 100644
--- a/.github/workflows/package-windows.yml
+++ b/.github/workflows/package-windows.yml
@@ -6,7 +6,7 @@ on:
   pull_request:
     paths:
       - "packaging/windows/**"
-      - "assets/icon/**"
+      - "assets/branding/**"
       - "crates/**"
       - "Cargo.toml"
       - "Cargo.lock"
diff --git a/Cargo.lock b/Cargo.lock
index 83e5c82..fecb6a2 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -1487,7 +1487,9 @@ dependencies = [
  "novo-canvas",
  "novo-core",
  "novo-storage",
+ "novo-theme",
  "rfd",
+ "ron",
  "serde",
  "tempfile",
  "winresource",
diff --git a/assets/icon/novoelectric.ico b/assets/icon/novoelectric.ico
deleted file mode 100644
