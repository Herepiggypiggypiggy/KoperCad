{
  "id": "edit-cabinet-and-part-picker",
  "category": "edit",
  "title": "Put a finished starter into a 600 x 800 cabinet and pick the contactor from the part catalog",
  "setup": [
    {
      "action": "add_page",
      "args": {
        "name": "1",
        "title": "Motor"
      }
    },
    {
      "action": "place_macro",
      "args": {
        "macro": "Motor starter DOL",
        "page": "1"
      }
    },
    {
      "action": "terminate_pin",
      "args": {
        "pin": "-F1:1",
        "potential": "L1"
      }
    },
    {
      "action": "terminate_pin",
      "args": {
        "pin": "-F1:3",
        "potential": "L2"
      }
    },
    {
      "action": "terminate_pin",
      "args": {
        "pin": "-F1:5",
        "potential": "L3"
      }
    },
    {
      "action": "terminate_pin",
      "args": {
        "pin": {
          "symbol_id": 14,
          "pin": "1"
        },
        "potential": "PE"
      }
    },
    {
      "action": "terminate_pin",
      "args": {
        "pin": "-F3:1",
        "potential": "L1"
      }
    },
    {
      "action": "terminate_pin",
      "args": {
        "pin": "-K1:A2",
        "potential": "N"
      }
    },
    {
      "action": "number_wires",
      "args": {}
    }
  ],
  "turns": [
    {
      "prompt": "Put the starter in a new cabinet +CAB1 with a 600 x 800 mm plate and choose a contactor for -K1 from the catalog. Check that nothing overlaps.",
      "script": [
        {
          "text": "",
          "calls": [
            {
              "tool": "read_project",
              "input": {
                "section": "cabinet"
              }
            },
            {
              "tool": "search_catalog",
              "input": {
                "query": "contactor",
                "device": "-K1",
                "limit": 3
              }
            }
          ]
        },
        {
          "text": "",
          "calls": [
            {
              "tool": "set_plan",
              "input": {
                "steps": [
                  {
                    "title": "Create cabinet +CAB1",
                    "status": "doing"
                  },
                  {
                    "title": "Pick contactor for -K1 (real size first)",
                    "status": "todo"
                  },
                  {
                    "title": "Place all devices",
                    "status": "todo"
                  },
                  {
                    "title": "Check layout",
                    "status": "todo"
                  }
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "calls": [
            {
              "tool": "propose_edit",
              "input": {
                "action": "add_cabinet",
                "args": {
                  "tag": "+CAB1",
                  "description": "Motor cabinet",
                  "width": 600,
                  "height": 800
                }
              }
            },
            {
              "tool": "propose_edit",
              "input": {
                "action": "assign_catalog_part",
                "args": {
                  "device": "-K1",
                  "manufacturer": "Schneider Electric",
                  "order_number": "LC1D09P7"
                }
              }
            },
            {
              "tool": "propose_edit",
              "input": {
                "action": "place_all_in_cabinet",
                "args": {}
              }
            }
          ]
        },
        {
          "text": "",
          "calls": [
            {
              "tool": "read_project",
              "input": {
                "section": "cabinet"
              }
            },
            {
              "tool": "run_checks",
              "input": {}
            }
          ]
        },
        {
          "text": "The cabinet +CAB1 (600 x 800 mm plate) is in the draft with every device of the starter placed on new DIN rails, and the cabinet section shows no overlaps or rails that are too short. For -K1 I took the Schneider Electric LC1D09P7 from the part catalog: it is a 9 A contactor with a 230 V coil, so check the coil voltage against your control voltage and the motor current against the motor plate before you order. Sizes of parts without dimensions are default guesses, and the layout checks do not replace a heat calculation or a look at the real mounting plate. Apply the change set to keep it; it is one undo step.",
          "calls": []
        }
      ]
    }
  ],
  "expect": {
    "devices_include": [
      "-K1"
    ],
    "errors_max": 0,
    "verified": true,
    "keep_existing": true,
    "cabinet_placed": [
      "-K1",
      "-F1"
    ],
    "cabinet_problems_max": 0,
    "assigned": [
      {
        "device": "-K1",
        "order_number": "LC1D09P7"
      }
    ],
    "plan_shown": true,
    "steps_max": 6
  }
}