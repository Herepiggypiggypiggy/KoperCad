{
  "id": "edit-add-run-lamp",
  "category": "edit",
  "title": "Add a green run lamp across the contactor coil of a finished starter",
  "setup": [
    {
      "action": "add_page",
      "args": {
        "name": "1",
        "title": "Motor"
      }
    },
    {
      "action": "place_macro",
      "args": {
        "macro": "Motor starter DOL",
        "page": "1"
      }
    },
    {
      "action": "terminate_pin",
      "args": {
        "pin": "-F1:1",
        "potential": "L1"
      }
    },
    {
      "action": "terminate_pin",
      "args": {
        "pin": "-F1:3",
        "potential": "L2"
      }
    },
    {
      "action": "terminate_pin",
      "args": {
        "pin": "-F1:5",
        "potential": "L3"
      }
    },
    {
      "action": "terminate_pin",
      "args": {
        "pin": {
          "symbol_id": 14,
          "pin": "1"
        },
        "potential": "PE"
      }
    },
    {
      "action": "terminate_pin",
      "args": {
        "pin": "-F3:1",
        "potential": "L1"
      }
    },
    {
      "action": "terminate_pin",
      "args": {
        "pin": "-K1:A2",
        "potential": "N"
      }
    },
    {
      "action": "number_wires",
      "args": {}
    }
  ],
  "turns": [
    {
      "prompt": "Add a green run lamp to page 1 that lights while the motor contactor is energised.",
      "script": [
        {
          "text": "I'll look at where the contactor coil is first.",
          "calls": [
            {
              "tool": "read_project",
              "input": {
                "section": "symbols",
                "filter": "-K1"
              }
            },
            {
              "tool": "list_symbols",
              "input": {
                "query": "lg"
              }
            }
          ]
        },
        {
          "text": "",
          "calls": [
            {
              "tool": "propose_edit",
              "input": {
                "action": "place_symbol",
                "args": {
                  "symbol": "iec/signalling/lamp_green",
                  "page": "1"
                }
              }
            }
          ]
        },
        {
          "text": "",
          "calls": [
            {
              "tool": "propose_edit",
              "input": {
                "action": "connect",
                "args": {
                  "from": "-P1:X1",
                  "to": "-K1:A1"
                }
              }
            },
            {
              "tool": "propose_edit",
              "input": {
                "action": "connect",
                "args": {
                  "from": "-P1:X2",
                  "to": "-K1:A2"
                }
              }
            },
            {
              "tool": "propose_edit",
              "input": {
                "action": "number_wires",
                "args": {}
              }
            }
          ]
        },
        {
          "text": "",
          "calls": [
            {
              "tool": "run_checks",
              "input": {}
            }
          ]
        },
        {
          "text": "The green lamp -P1 is in the draft, wired in parallel with the coil of -K1, so it lights whenever the contactor is energised. That shows the contactor is pulled in, not that the motor is actually running (an auxiliary contact or the overload state would tell more). The design checks report no new problems. I placed it in free space on page 1: move it where you want it.",
          "calls": []
        }
      ]
    }
  ],
  "expect": {
    "devices_include": [
      "-P1"
    ],
    "errors_max": 0,
    "open_pins_max": 0,
    "all_wires_numbered": true,
    "verified": true,
    "keep_existing": true,
    "steps_max": 6
  }
}
