{
  "id": "edit-fix-check-errors",
  "category": "edit",
  "title": "Find and fix the design-check errors in a project",
  "setup": [
    {
      "action": "add_page",
      "args": {
        "name": "1",
        "title": "Motor"
      }
    },
    {
      "action": "place_macro",
      "args": {
        "macro": "Motor starter DOL",
        "page": "1"
      }
    },
    {
      "action": "terminate_pin",
      "args": {
        "pin": "-F1:1",
        "potential": "L1"
      }
    },
    {
      "action": "terminate_pin",
      "args": {
        "pin": "-F1:3",
        "potential": "L2"
      }
    },
    {
      "action": "terminate_pin",
      "args": {
        "pin": "-F1:5",
        "potential": "L3"
      }
    },
    {
      "action": "terminate_pin",
      "args": {
        "pin": {
          "symbol_id": 14,
          "pin": "1"
        },
        "potential": "PE"
      }
    },
    {
      "action": "terminate_pin",
      "args": {
        "pin": "-F3:1",
        "potential": "L1"
      }
    },
    {
      "action": "terminate_pin",
      "args": {
        "pin": "-K1:A2",
        "potential": "N"
      }
    },
    {
      "action": "number_wires",
      "args": {}
    },
    {
      "action": "place_symbol",
      "args": {
        "symbol": "iec/contacts/no",
        "page": "1"
      }
    }
  ],
  "turns": [
    {
      "prompt": "Run the checks and fix whatever is wrong with this page.",
      "script": [
        {
          "text": "",
          "calls": [
            {
              "tool": "set_plan",
              "input": {
                "steps": [
                  {
                    "title": "Run the design checks",
                    "status": "doing"
                  },
                  {
                    "title": "Fix the errors",
                    "status": "todo"
                  },
                  {
                    "title": "Check again",
                    "status": "todo"
                  }
                ]
              }
            },
            {
              "tool": "run_checks",
              "input": {}
            }
          ]
        },
        {
          "text": "The checks report a contact with no coil. It is a stray device, not part of the starter, so I remove it.",
          "calls": [
            {
              "tool": "propose_edit",
              "input": {
                "action": "remove_device",
                "args": {
                  "device": "-K2"
                }
              }
            }
          ]
        },
        {
          "text": "",
          "calls": [
            {
              "tool": "run_checks",
              "input": {}
            }
          ]
        },
        {
          "text": "Fixed: the checks reported one error, a contact -K2 drawn with no coil. I removed it; it was not wired to anything. The design checks now find no errors or open pins. Parts are still unassigned (shown as notes).",
          "calls": []
        }
      ]
    }
  ],
  "expect": {
    "devices_exclude": [
      "-K2"
    ],
    "devices_include": [
      "-K1",
      "-M1"
    ],
    "errors_max": 0,
    "open_pins_max": 0,
    "resolves_min": 1,
    "verified": true,
    "plan_shown": true,
    "steps_max": 2
  }
}
